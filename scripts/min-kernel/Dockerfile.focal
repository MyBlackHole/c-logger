FROM ubuntu:14.04 AS kernel-builder

ENV DEBIAN_FRONTEND=noninteractive
ARG KERNEL_VERSION=3.17.8

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
         build-essential bc ca-certificates curl xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/min-kernel \
    && curl -fsSL "https://cdn.kernel.org/pub/linux/kernel/v3.x/linux-${KERNEL_VERSION}.tar.xz" \
         -o /tmp/linux.tar.xz \
    && tar -C /tmp -xf /tmp/linux.tar.xz \
    && cd "/tmp/linux-${KERNEL_VERSION}" \
    && make x86_64_defconfig \
    && scripts/config --disable MODULES \
         --disable RANDOMIZE_BASE \
         --enable DEVTMPFS \
         --enable DEVTMPFS_MOUNT \
         --enable PROC_FS \
         --enable SYSFS \
         --enable TMPFS \
         --enable UNIX \
         --enable PCI \
         --enable VIRTIO \
         --enable VIRTIO_PCI \
         --enable VIRTIO_BLK \
         --enable EXT4_FS \
         --enable XFS_FS \
         --enable SERIAL_8250 \
         --enable SERIAL_8250_CONSOLE \
    && make olddefconfig \
    && make -j2 bzImage \
    && gcc -v > /opt/min-kernel/compiler.txt 2>&1 \
    && cp arch/x86/boot/bzImage /opt/min-kernel/bzImage \
    && rm -rf "/tmp/linux-${KERNEL_VERSION}" /tmp/linux.tar.xz


FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive
ARG XMAKE_VERSION=3.1.1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates cmake curl file git pkg-config python3 binutils \
    util-linux busybox-static \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --recurse-submodules --shallow-submodules \
        --branch "v${XMAKE_VERSION}" https://github.com/xmake-io/xmake.git /tmp/xmake \
    && cd /tmp/xmake \
    && ./configure --prefix=/usr/local \
    && make -j2 \
    && make install \
    && rm -rf /tmp/xmake

COPY --from=kernel-builder /opt/min-kernel /opt/min-kernel

RUN test "$(getconf GNU_LIBC_VERSION)" = "glibc 2.31" \
    && test -s /opt/min-kernel/bzImage \
    && grep -q 'gcc version 4\.8' /opt/min-kernel/compiler.txt
