@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
set(Logger_VERSION "@PROJECT_VERSION@")
set(Logger_ABI_VERSION "@LOGGER_ABI_VERSION@")
set(Logger_CRYPTO_IMPLEMENTATION "builtin-sha256")
set(Logger_RELEASE_CANDIDATE TRUE)
set(Logger_shared_FOUND @BUILD_SHARED_LIBS@)
if(Logger_shared_FOUND)
  set(Logger_static_FOUND FALSE)
else()
  set(Logger_static_FOUND TRUE)
endif()
set(Logger_legacy_fork_FOUND @LOGGER_ENABLE_LEGACY_FORK_HELPER@)
include("${CMAKE_CURRENT_LIST_DIR}/LoggerTargets.cmake")
check_required_components(Logger)
